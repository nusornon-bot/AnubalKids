# GEMINI_API_KEY: Required for server-side Gemini AI API calls (from Google AI Studio free tier or paid tier).
# Local Node dev: place in `.env`.
# Cloudflare Workers local dev: place in `.dev.vars` (see `.dev.vars.example`).
# Cloudflare Workers production: run `npx wrangler secret put GEMINI_API_KEY`.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model override (defaults to gemini-4-hydrogen)
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Optional hosted URL for self-referential links
APP_URL="MY_APP_URL"

# VITE_APPS_SCRIPT_URL: Optional Google Apps Script Web App URL for direct Google Sheets logging without OAuth
VITE_APPS_SCRIPT_URL=

